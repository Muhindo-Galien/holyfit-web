# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the example, which holds no key and is the only written record of
# which Clerk instance goes where and what /admin needs to reach the API.
# The broad rule above swallowed it, which is why that setup lived on one
# laptop until 2026-09-26.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
